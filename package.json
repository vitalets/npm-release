{
  "name": "@vitalets/npm-release",
  "description": "Interactive CLI for npm releases through GitHub Actions",
  "version": "2.5.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitalets/npm-release.git"
  },
  "bin": {
    "npm-release": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "test": "node --test test/*.test.ts test/changelog-merge/*.test.ts extension/test/*.test.ts",
    "sync": "git pull && git fetch --tags --force",
    "demo:cli": "node scripts/demo-cli.ts",
    "demo:changelog-merge": "node scripts/demo-changelog-merge.ts",
    "release": "node src/cli/index.ts .github/workflows/release.yml",
    "release:next": "npm run release -- --channel next"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/semver": "^7.8.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
